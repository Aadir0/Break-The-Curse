  sentenceText: {fileID: 1444783478}
  sentences:
  - '"Night fades.


    Stars disappear.


    Dreams become memories.


    Fear
    becomes strength.


    And somewhere between darkness and dawn...


    A child
    learns that even nightmares can bleed."'
  characterDelay: 0.06
  sentenceInterval: 1.5
  hideAfterLastSentence: 0
  spaceSkipsTypingAndInterval: 0
