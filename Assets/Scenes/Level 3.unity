  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2021139804716070521}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7382ee6825142cd43aa3754d7c7b55df, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialWriting
  typewriterCanvas: {fileID: 7074772172351264344}
  sentenceText: {fileID: 4237683605151264848}
  continueText: {fileID: 4929098901549491491}
  audioSource: {fileID: 8358915567085667477}
  typingClip: {fileID: 8300000, guid: a6151967fcb599c4bb8709bc36d22126, type: 3}
  typingVolume: 0.7
  sentences:
  - 'The nightmare collapses into silence.


    The monsters vanish.


    The darkness
    slowly fades.'
  - 'Morning is near.


    The child opens his eyes...


    For the first time
    in a week... there are no screams.


    Only quiet.


    The future smiles
    before disappearing.'
  - '"This isn''t over..."


    "But you''ve made it to another sunrise."'
  - 'The nightmare sleeps... for now.


    Thank you for playing.'
  wordDelay: 0.08
  sentencePause: 2
  continuePrompt: Press Space to Continue
