  typingClip: {fileID: 8300000, guid: 1436eb62deb2b3c478bf81a80b2ca536, type: 3}
  typingVolume: 0.7
  sentences:
  - 'The nightmare remembers.


    The monsters return... stronger than before.'
  - 'Every victory only feeds the darkness.


    Every step forward reveals another
    hidden fear...'
  - 'The future refuses to surrender...


    But protecting the past has a price.'
  wordDelay: 0.08
  sentencePause: 2
  continuePrompt: Press Space to Continue
