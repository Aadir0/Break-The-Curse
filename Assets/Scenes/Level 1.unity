  m_Script: {fileID: 11500000, guid: 7382ee6825142cd43aa3754d7c7b55df, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialWriting
  typewriterCanvas: {fileID: 2099988600308890578}
  sentenceText: {fileID: 2363911872468935740}
  continueText: {fileID: 7913777561627389081}
  audioSource: {fileID: 8423824908003875481}
  typingClip: {fileID: 8300000, guid: 1436eb62deb2b3c478bf81a80b2ca536, type: 3}
  typingVolume: 0.7
  sentences:
  - 'For seven nights... sleep has never brought peace.


    Every dream has become
    darker than the last.'
  - 'Tonight feels different.


    The shadows are waiting...'
  - But someone else has entered this nightmare.
  - 'Someone who knows these monsters...


    Someone who has fought them before.'
  wordDelay: 0.08
  sentencePause: 2
  continuePrompt: Press Space to Continue
