  sentenceText: {fileID: 402283513774323636}
  sentences:
  - 'Future Self:  "Don''t be afraid."'
  - 'Future Self: "I know none of this makes sense..."'
  - 'Future Self: "But I''ve lived through these nightmares."'
  - 'Future Self: "I''m you... many years from now."'
  - 'Future Self: "Stay behind me. I''ll make sure you wake up."'
  characterDelay: 0.1
  sentenceInterval: 15
  hideAfterLastSentence: 1
  spaceSkipsTypingAndInterval: 0
